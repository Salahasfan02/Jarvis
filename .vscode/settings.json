{
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.analysis.extraPaths": ["backend"],
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  "files.exclude": {
    "**/__pycache__": true,
    "**/.venv": false
  },
  "[python]": {
    "editor.tabSize": 4
  },
  "[typescript]": {
    "editor.tabSize": 2
  },
  "[typescriptreact]": {
    "editor.tabSize": 2
  }
}
